# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=
DB_NAME=pizzahub

# Better Auth (Next.js client URL, JWKS ও token issuer এর জন্য)
BETTER_AUTH_URL=http://localhost:3000
# Stripe (test mode key, dashboard.stripe.com থেকে)
STRIPE_SECRET_KEY=
PREMIUM_PRICE_CENTS=999
STRIPE_CURRENCY=usd
STRIPE_WEBHOOK_SECRET=

# Email (Gmail হলে App Password লাগবে, নিচে নোট দেখুন)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PizzaHub <your-email@gmail.com>